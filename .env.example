# Copy to .env.local for local development. Never commit real values.

# Service account key JSON (one line). Share each company sheet + the registry sheet with its client_email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Google Sheet that lists the companies (tab "Companies": Name | Sheet URL | Color | Active)
REGISTRY_SHEET_ID=
# Login password for the app
APP_PASSWORD=
# Long random string (32+ chars): encrypts secrets stored in sheets and signs the session. Do not change after setup.
APP_SECRET=
# Protects /api/cron (?key=... or Authorization: Bearer ...)
CRON_SECRET=

# Optional: public URL for one-click unsubscribe links (defaults to the Vercel production URL)
# APP_URL=https://your-app.vercel.app
# Demo mode with fake sheet/SMTP/IMAP/monday (also automatic when GOOGLE_SERVICE_ACCOUNT_JSON is empty)
# DEMO=1
